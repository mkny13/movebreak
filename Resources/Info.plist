<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>MoveBreak</string>
    <key>CFBundleDisplayName</key>
    <string>MoveBreak</string>
    <key>CFBundleExecutable</key>
    <string>MoveBreak</string>
    <key>CFBundleIdentifier</key>
    <string>com.mike.movebreak</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.1</string>
    <key>CFBundleVersion</key>
    <string>2</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.4</string>

    <!-- Menu-bar only: no Dock icon, and the app never activates over your meeting. -->
    <key>LSUIElement</key>
    <true/>

    <!-- Required to ask Chrome/Safari what's in their tabs. Without this the Automation
         prompt never appears and tab reads fail with error -1743. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>MoveBreak checks your browser's open tabs to tell a video you're watching apart from music you're listening to, so it only interrupts you for the former.</string>
</dict>
</plist>
